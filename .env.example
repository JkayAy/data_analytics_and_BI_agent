# InsightBridge — environment variables
# Copy to .env at repo root (never commit .env)

# --- LLM (optional: demo mode works without a key for curated questions) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Postgres (local Docker default) ---
DATABASE_URL=postgresql://insight:insight@localhost:5432/insightbridge

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
QUERY_ROW_LIMIT=10000
QUERY_TIMEOUT_SECONDS=30
# Optional: require X-API-Key on POST routes (set same value as NEXT_PUBLIC_API_KEY on Vercel)
API_KEY=
# Multi-agent orchestration (LangGraph); falls back to sequential if false or import fails
MULTI_AGENT_USE_LANGGRAPH=true
INVESTIGATION_MAX_QUERIES=5
INVESTIGATION_BUDGET_MS=120000
CONVERSATION_HISTORY_TURNS=6

# --- Next.js (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
# Must match API_KEY when API_KEY is set on Railway
NEXT_PUBLIC_API_KEY=
# Your repo URL after GitHub push
NEXT_PUBLIC_GITHUB_URL=https://github.com/JkayAy/data_analytics_and_BI_agent
# Optional: password-protect public Vercel demo (server-side only on Vercel env)
DEMO_ACCESS_PASSWORD=
MAGIC_LINK_DEV_EXPOSE=true
AUTH_REQUIRED=false
JWT_SECRET=dev-change-me-in-production
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=60
MONTHLY_QUERY_CAP=0
SLACK_SIGNING_SECRET=
